<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:title="Add material"
        app:titleTextColor="@color/text_main" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/space_sm"
        android:indeterminate="true"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/corner_md"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        style="@style/Text.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Material information" />

                    <EditText
                        android:id="@+id/etMaterialName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:background="@drawable/bg_input"
                        android:hint="Material name"
                        android:inputType="text"
                        android:minHeight="@dimen/input_height"
                        android:paddingStart="@dimen/space_md"
                        android:paddingEnd="@dimen/space_md"
                        android:textColor="@color/text_main"
                        android:textSize="@dimen/text_body" />

                    <EditText
                        android:id="@+id/etMaterialDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:background="@drawable/bg_input"
                        android:gravity="top|start"
                        android:hint="Description"
                        android:inputType="textMultiLine"
                        android:lines="3"
                        android:minHeight="@dimen/input_height"
                        android:paddingStart="@dimen/space_md"
                        android:paddingTop="@dimen/space_md"
                        android:paddingEnd="@dimen/space_md"
                        android:paddingBottom="@dimen/space_md"
                        android:textColor="@color/text_main"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="Category"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />

                    <Spinner
                        android:id="@+id/spinnerMaterialCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:background="@drawable/bg_input"
                        android:minHeight="@dimen/input_height"
                        android:paddingStart="@dimen/space_md"
                        android:paddingEnd="@dimen/space_md" />

                    <EditText
                        android:id="@+id/etTotalQuantity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:background="@drawable/bg_input"
                        android:hint="Total quantity"
                        android:inputType="number"
                        android:minHeight="@dimen/input_height"
                        android:paddingStart="@dimen/space_md"
                        android:paddingEnd="@dimen/space_md"
                        android:textColor="@color/text_main"
                        android:textSize="@dimen/text_body" />

                    <EditText
                        android:id="@+id/etImageUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:background="@drawable/bg_input"
                        android:hint="Image URL (optional)"
                        android:inputType="textUri"
                        android:minHeight="@dimen/input_height"
                        android:paddingStart="@dimen/space_md"
                        android:paddingEnd="@dimen/space_md"
                        android:singleLine="true"
                        android:textColor="@color/text_main"
                        android:textSize="@dimen/text_body" />

                    <Button
                        android:id="@+id/btnSaveMaterial"
                        style="@style/Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:text="@string/save" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
