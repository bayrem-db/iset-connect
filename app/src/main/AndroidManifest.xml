<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ISETConnect"
        android:usesCleartextTraffic="true">

        <activity android:name=".activities.SplashActivity" android:exported="true" android:noHistory="true"
            android:theme="@style/Theme.ISETConnect.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".activities.LoginActivity" android:exported="false" />
        <activity android:name=".activities.RegisterActivity" android:exported="false" />
        <activity android:name=".activities.WaitingApprovalActivity" android:exported="false" />
        <activity android:name=".activities.RejectedAccountActivity" android:exported="false" />
        <activity android:name=".activities.ForgotPasswordActivity" android:exported="false" />
        <activity android:name=".activities.ChangePasswordActivity" android:exported="false" />
        <activity android:name=".activities.NotificationsActivity" android:exported="false" />

        <activity android:name=".activities.admin.AdminDashboardActivity" android:exported="false" />
        <activity android:name=".activities.admin.ManageStudentsActivity" android:exported="false" />
        <activity android:name=".activities.admin.StudentDetailsActivity" android:exported="false" />
        <activity android:name=".activities.admin.ManageMaterialsActivity" android:exported="false" />
        <activity android:name=".activities.admin.AddMaterialActivity" android:exported="false" />
        <activity android:name=".activities.admin.EditMaterialActivity" android:exported="false" />
        <activity android:name=".activities.admin.BorrowRequestsActivity" android:exported="false" />
        <activity android:name=".activities.admin.ManageInternshipsActivity" android:exported="false" />
        <activity android:name=".activities.admin.AddInternshipActivity" android:exported="false" />
        <activity android:name=".activities.admin.EditInternshipActivity" android:exported="false" />
        <activity android:name=".activities.admin.InternshipApplicationsActivity" android:exported="false" />

        <activity android:name=".activities.student.StudentDashboardActivity" android:exported="false" />
        <activity android:name=".activities.student.EquipmentListActivity" android:exported="false" />
        <activity android:name=".activities.student.EquipmentDetailsActivity" android:exported="false" />
        <activity android:name=".activities.student.MyLoansActivity" android:exported="false" />
        <activity android:name=".activities.student.InternshipListActivity" android:exported="false" />
        <activity android:name=".activities.student.InternshipDetailsActivity" android:exported="false" />
        <activity android:name=".activities.student.MyApplicationsActivity" android:exported="false" />
        <activity android:name=".activities.student.StudentProfileActivity" android:exported="false" />
        <activity android:name=".activities.student.ApplyInternshipActivity" android:exported="false" />
    </application>
</manifest>
